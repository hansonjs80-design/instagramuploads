# 서버에서만 사용하는 OpenAI API 키입니다. 실제 키를 커밋하지 마세요.
OPENAI_API_KEY=

# Structured Outputs를 지원하는 모델을 지정하세요.
OPENAI_MODEL=gpt-5-mini

# Live Preview Editor의 Regenerate Image 기능에 사용합니다.
OPENAI_IMAGE_MODEL=gpt-image-2

# 선택 사항: 네이버 데이터랩 검색어 트렌드. 2026-07-31 이후 신규 키는 NAVER API HUB에서 발급합니다.
NAVER_API_PROVIDER=NAVER_API_HUB
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# API HUB가 별도 endpoint를 제공할 경우 설정합니다. 비어 있으면 공식 DataLab endpoint를 사용합니다.
NAVER_API_HUB_BASE_URL=

# Instagram API with Instagram Login. Never commit real credentials.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/oauth/callback
INSTAGRAM_API_VERSION=v23.0
APP_BASE_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=
INSTAGRAM_PUBLISH_MODE=MOCK
# MOCK 모드에서는 아래 provider와 token을 사용하지 않습니다.
# LIVE + Vercel 배포에서는 VERCEL_BLOB을 권장합니다.
MEDIA_STORAGE_PROVIDER=CUSTOM_PUBLIC
BLOB_READ_WRITE_TOKEN=
MEDIA_STORAGE_PUBLIC_BASE_URL=

# Private single-owner studio authentication
STUDIO_OWNER_EMAIL=
# Format: iterations:salt:64-char-pbkdf2-sha256-hex (run npm run auth:hash -- "your password")
STUDIO_PASSWORD_HASH=
STUDIO_SESSION_SECRET=

# Local uses sqlite. Vercel production requires a persistent database adapter.
DATABASE_PROVIDER=sqlite
DATABASE_URL=
